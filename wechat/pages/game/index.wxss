.stage {
  width: 100%;
  height: 100%;
  display: block;
}

/* 原来：cover-view 想盖住原生画布，验收里没有露出红字。
   现在：canvas 被 wx:if 摘掉之后，这块普通 view 自己占住页面。
   为什么：原生组件还在树上时，普通 view 和 cover-view 都会被挡住。 */
.fallback {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  padding: 16px;
  color: #ff5c5c;
  font-size: 16px;
  font-weight: 700;
  background-color: #143d2c;
}
