<canvas
  wx:if="{{showCanvas}}"
  type="2d"
  id="game-canvas"
  class="stage"
  disable-scroll="{{true}}"
  bindtouchstart="onTouchStart"
  bindtouchmove="onTouchMove"
  bindtouchend="onTouchEnd"
  bindtouchcancel="onTouchCancel"
></canvas>
<!--
  原来：node 缺失和 context 缺失共用 cover-view，盖在仍挂着的原生画布上。验收里两种写法都看不见字。
  现在：两条路径各自一块普通 view。showCanvas 为 false 时 canvas 不在树上。
  为什么：原生组件还在树上时，普通 view 和 cover-view 都会被挡住。?p06= 探针不走这里。
  需要复核：没有新的模拟器截图，不能把红字写成已经看见。
-->
<view wx:if="{{canvasNodeMissing}}" class="fallback">{{canvasNodeMissingText}}</view>
<view wx:if="{{canvasContextMissing}}" class="fallback">{{canvasContextMissingText}}</view>
